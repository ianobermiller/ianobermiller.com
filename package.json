  "keywords": [
    "typescript"
  ],
  "license": "MIT",
  "main": "n/a",
  "type": "module",
  "scripts": {
    "build": "next build --webpack",
    "start": "NODE_OPTIONS='--inspect --max-http-header-size=81000' next dev --webpack",
    "lint": "eslint --cache --cache-location .next/cache/eslint/",
    "lint:fix": "eslint --fix",
    "format": "prettier --parser typescript --trailing-comma es5 --no-semi --single-quote --write \"src/**/*.ts*\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "analyze": "ANALYZE=true next build --webpack",
    "analyze:server": "BUNDLE_ANALYZE=server next build --webpack",
    "analyze:browser": "BUNDLE_ANALYZE=browser next build --webpack"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.4",
    "@next/eslint-plugin-next": "^16.1.4",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "eslint-plugin-mdx": "^3.6.2",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSpacing": false,
    "bracketSameLine": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 80,
    "overrides": [
      {
        "files": "*.mdx",
        "options": {
          "printWidth": 60
        }
      }
    ]
  }
}
