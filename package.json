    "@types/cheerio": "^1.0.0",
    "@types/date-fns": "^2.6.3",
    "@types/node": "^25.0.10",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/webpack-env": "^1.18.8",
    "@vercel/node": "^5.5.27",
    "cheerio": "^1.2.0",
    "date-fns": "^4.1.0",
    "estree-util-is-identifier-name": "^3.0.0",
    "estree-util-value-to-estree": "^3.5.0",
    "feed": "^5.2.0",
    "formdata-node": "^6.0.3",
    "formdata-polyfill": "^4.0.10",
    "gray-matter": "^4.0.3",
    "ical-generator": "^10.0.0",
    "js-yaml": "^4.1.1",
    "next": "^16.1.4",
    "node-fetch": "^3.3.2",
    "prismjs": "^1.30.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "readdirp": "^5.0.0",
    "recoil": "^0.7.7",
    "remark-frontmatter": "^5.0.0",
